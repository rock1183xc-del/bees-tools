{
  "version": 2,
  "builds": [
    { "src": "api/tools.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "css/*", "use": "@vercel/static" },
    { "src": "js/*", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ],
  "functions": {
    "api/tools.js": {
      "memory": 128,
      "maxDuration": 10
    }
  }
}
